VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_key_here

# Redsys/Cyberpac: these values are consumed by Supabase Edge Functions, not by Vite.
CAIXABANK_CYBERPAC_MERCHANT_CODE=369901590
CAIXABANK_CYBERPAC_TERMINAL=1
CAIXABANK_CYBERPAC_CURRENCY=978
CAIXABANK_CYBERPAC_TRANSACTION_TYPE=0
CAIXABANK_CYBERPAC_SIGNATURE_VERSION=HMAC_SHA256_V1
CAIXABANK_CYBERPAC_ENDPOINT=https://sis-t.redsys.es:25443/sis/realizarPago
